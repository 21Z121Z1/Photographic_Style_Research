+pub fn apple_style_histogram_light_map(
+    request: &AppleStyleLightMapRequest<'_>,
+    normalizer: f32,
+) -> Result<Vec<u8>, AppleStyleDataError> {
+    if request.width == 0
+        || request.height == 0
+        || request.width.checked_mul(request.height) != Some(request.luma.len())
