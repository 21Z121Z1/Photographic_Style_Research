+/// Minimize the ridge quadratic while keeping every residual coefficient in
+/// its box. Active bounds stay fixed while the remaining terms are refitted;
+/// a bound is released when its gradient points back into the feasible region.
+fn solve_bounded_system(
+    matrix: &[f64],
+    vector: &[f64],
+    bounds: &[f64],
+) -> Result<Vec<f64>, AppleStyleDataError> {
+    let count = vector.len();
+    if matrix.len() != count * count || bounds.len() != count {
+        return Err(AppleStyleDataError::SingularSystem);
+    }
+    let mut values = vec![0.0; count];
+    // -1: lower bound, 0: free, +1: upper bound.
+    let mut active = vec![0_i8; count];
+    let tolerance = 1e-10 * vector.iter().map(|v| v.abs()).fold(1.0, f64::max);
+    for _ in 0..(4 * count * count) {
+        let free = (0..count).filter(|&i| active[i] == 0).collect::<Vec<_>>();
+        let mut reduced = Vec::with_capacity(free.len() * free.len());
+        let mut rhs = Vec::with_capacity(free.len());
+        for &row in &free {
+            let fixed = (0..count)
+                .filter(|&i| active[i] != 0)
+                .map(|i| matrix[row * count + i] * values[i])
+                .sum::<f64>();
+            rhs.push(vector[row] - fixed);
+            reduced.extend(free.iter().map(|&column| matrix[row * count + column]));
+        }
+        let solved = solve_linear_system(&reduced, &rhs)?;
+        let mut candidate = values.clone();
+        for (&index, value) in free.iter().zip(solved) {
+            candidate[index] = value;
+        }
+        let mut step = 1.0_f64;
+        let mut hit = None;
+        for &index in &free {
+            let boundary = if candidate[index] > bounds[index] {
+                bounds[index]
+            } else if candidate[index] < -bounds[index] {
+                -bounds[index]
+            } else {
+                continue;
+            };
+            let fraction = (boundary - values[index]) / (candidate[index] - values[index]);
+            if fraction < step {
+                step = fraction;
+                hit = Some((index, boundary));
+            }
+        }
+        if let Some((index, boundary)) = hit {
+            for &i in &free {
+                values[i] += step * (candidate[i] - values[i]);
+            }
+            values[index] = boundary;
+            active[index] = if boundary < 0.0 { -1 } else { 1 };
+            continue;
+        }
+        values = candidate;
+        let release = (0..count)
+            .filter(|&i| active[i] != 0)
+            .map(|i| {
+                let gradient = (0..count)
+                    .map(|j| matrix[i * count + j] * values[j])
+                    .sum::<f64>()
+                    - vector[i];
+                (i, gradient * f64::from(active[i]))
+            })
+            .filter(|&(_, violation)| violation > tolerance)
+            .max_by(|left, right| left.1.total_cmp(&right.1));
+        if let Some((index, _)) = release {
+            active[index] = 0;
+        } else {
+            return Ok(values);
+        }
+    }
+    Err(AppleStyleDataError::SingularSystem)
+}
