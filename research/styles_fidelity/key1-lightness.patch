+/// Scene chromaticity from the thumbnail at the displayed primary's luminance.
+///
+/// A pixel without thumbnail luminance carries no chroma and keeps the
+/// primary, so remove-style stays the identity there.
+fn luminance_preserving_revert_target(primary: &[f32], thumbnail: &[f32]) -> Vec<f32> {
+    let mut target = Vec::with_capacity(primary.len());
+    for (base, scene) in primary
+        .as_chunks::<3>()
+        .0
+        .iter()
+        .zip(thumbnail.as_chunks::<3>().0)
+    {
+        let base_luminance = f64::from(luminance(*base));
+        let scene_luminance = f64::from(luminance(*scene));
+        if scene_luminance > 1e-6 && base_luminance > 0.0 {
+            let scale = base_luminance / scene_luminance;
+            target.extend(scene.iter().map(|value| (f64::from(*value) * scale) as f32));
+        } else {
+            target.extend_from_slice(base);
+        }
+    }
+    target
